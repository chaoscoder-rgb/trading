# TradeVision backend configuration — copy to .env and fill in (server only).
#   cp .env.example .env && chmod 600 .env
# Every key is optional: a missing key means simulated/fallback data for that
# source, clearly labeled in the UI. NEVER commit the real .env.

# Market data — Massive (massive.com, formerly Polygon.io)
MASSIVE_API_KEY=

# News sentiment — Finnhub (free tier)
FINNHUB_API_KEY=

# Macro data — FRED (free)
FRED_API_KEY=

# Prediction markets — Kalshi
KALSHI_API_KEY=
# Either the full PEM with \n escapes, or (easier) base64 of the PEM file:
#   base64 -w0 kalshi-key.pem
KALSHI_RSA_PRIVATE_KEY=

# Metals second source — Goldprice.dev (works keyless; free key lifts limits)
GOLDPRICE_API_KEY=

# Fundamentals — World Bank + US Treasury need no key.
# Econdb token (optional, free): register at econdb.com for US industrial production
ECONDB_API_TOKEN=

# News NLP sentiment — MarketAux (free tier; sign up at marketaux.com)
MARKETAUX_API_TOKEN=

# Database — leave empty for local file / compose libsql container
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# Email notifications (trade confirmations + stop-loss alerts)
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_FROM=
SMTP_SERVER=
SMTP_PORT=587
